{
  "name": "arguscli",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "check": "bun --bun tsc --noEmit",
