    "test:live": "bun run scripts/smoke-live.ts"
  },
  "dependencies": {
    "@opentui/core": "0.7.0",
    "diff": "9.0.0",
    "openai": "7.45.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
